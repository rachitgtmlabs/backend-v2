MONGODB_URI=mongodb://127.0.0.1:27017/lease_iq
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Set to 1 or true to skip docTR model load on startup (faster boot / CI without uv)
OCR_SKIP_WARMUP=0

# Groq — lease analysis LLM (use a prompt-caching-supported model for best prefix reuse)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Structured Outputs: strict JSON Schema (gpt-oss-20b/120b). Set false for best-effort if you see 400s.
GROQ_JSON_SCHEMA_STRICT=true

# Write Groq request/response JSON under debug/lease-analysis/<traceId>/ (gitignored). Set 0 to disable.
LEASE_ANALYSIS_TRACE_FILES=1

# Kill hung docTR OCR subprocess after N ms (default 900000 = 15 min). Large PDFs need headroom.
OCR_SUBPROCESS_TIMEOUT_MS=900000
