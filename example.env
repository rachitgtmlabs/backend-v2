MONGODB_URI=mongodb://127.0.0.1:27017/lease_iq
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Set to 1 or true to skip docTR model load on startup (faster boot / CI without uv)
OCR_SKIP_WARMUP=0

# Groq — lease analysis LLM (use a prompt-caching-supported model for best prefix reuse)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Structured Outputs: strict JSON Schema (gpt-oss-20b/120b). Set false for best-effort if you see 400s.
GROQ_JSON_SCHEMA_STRICT=true

# OpenAI — chat assistant (orchestrator + answering agent in src/mastra).
# Required when CHAT_MODEL is an openai/* model. gpt-4o-mini natively supports
# response_format: json_schema, which makes the structured-output path robust.
OPENAI_API_KEY=

# Mastra model router string used by the chat agents (orchestrator + answering).
# Default: openai/gpt-4o-mini. Other valid values: openai/gpt-4.1-mini,
# groq/openai/gpt-oss-120b, anthropic/claude-3-5-haiku-latest, etc.
# CHAT_MODEL=openai/gpt-4o-mini

# Kill hung docTR OCR subprocess after N ms (default 900000 = 15 min). Large PDFs need headroom.
OCR_SUBPROCESS_TIMEOUT_MS=900000

# Public origin of this API (used for default property thumbnail URLs when GCS upload is skipped or fails).
# Example: https://api.yourdomain.com — omit in dev (defaults to http://localhost:$PORT)
# API_PUBLIC_URL=

# Google Cloud Storage — property thumbnails (optional). If unset or upload fails, thumbnail_url falls back to a built-in placeholder served from /static/placeholders/…
# Auth (pick one):
# - Application Default Credentials JSON: set GOOGLE_APPLICATION_CREDENTIALS to a path (service account key, or `gcloud auth application-default login` output).
#   Relative paths are resolved from the API process cwd (usually lease-backend-v2).
# - Or inline: GCS_CLIENT_EMAIL + GCS_PRIVATE_KEY (use \n for newlines in the key when inline in .env)
# GOOGLE_APPLICATION_CREDENTIALS=**.json
GCS_BUCKET=
GCS_PROJECT_ID=
# GCS_CLIENT_EMAIL=
# GCS_PRIVATE_KEY=

# Google Calendar — create calendar events for tasks/alerts (optional).
# Set GOOGLE_CALENDAR_ENABLED=false to disable without removing credentials.
# Default: true (no-ops gracefully when credentials are missing).
GOOGLE_CALENDAR_ENABLED=false

# Service account credentials (create at console.cloud.google.com → IAM → Service Accounts).
# The service account must be invited as an editor on GOOGLE_CALENDAR_ID.
# GOOGLE_CALENDAR_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_CALENDAR_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Which calendar to create events on (share this calendar with the service account above).
# Use 'primary' only if you configure domain-wide delegation; otherwise use a dedicated calendar ID.
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Placeholder attendee email for calendar invites (replace once auth is wired up).
# GOOGLE_CALENDAR_ATTENDEE_EMAIL=placeholder@example.com

# SMTP — for sending calendar invites (.ics) via email.
# Gmail example: use smtp.gmail.com with a Google App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password

# JWT — used by the auth module for signing access tokens.
JWT_SECRET=changeme
JWT_EXPIRES_IN=1h

# Firebase Admin — needed for Google / phone social login (verifyIdToken).
# Option A: explicit service account key fields
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Option B: Application Default Credentials — set GOOGLE_APPLICATION_CREDENTIALS instead.
